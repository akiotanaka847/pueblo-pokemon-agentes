# Copia este archivo a  agents/.env  y rellena lo que uses.
# agents/.env está en .gitignore y NUNCA debe subirse al repositorio.

# ══ Elige el cerebro por defecto: 'claude' | 'openai' | 'custom' ══
BRAIN=custom

# ── Opción 1: Claude (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── Opción 2: OpenAI ────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Opción 3: CUALQUIER API compatible con OpenAI ───────────
# Aquí entran casi todos los proveedores baratos y los modelos locales.
# Solo necesitas 3 datos: URL base, clave y modelo. Elige un preajuste:
#
#  🇨🇳 DeepSeek — muy barato, gran calidad
#     CUSTOM_NAME=DeepSeek
#     CUSTOM_BASE_URL=https://api.deepseek.com/v1
#     CUSTOM_MODEL=deepseek-chat
#
#  🇨🇳 Qwen (Alibaba)
#     CUSTOM_NAME=Qwen
#     CUSTOM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#     CUSTOM_MODEL=qwen-plus
#
#  🇨🇳 Kimi (Moonshot)
#     CUSTOM_NAME=Kimi
#     CUSTOM_BASE_URL=https://api.moonshot.cn/v1
#     CUSTOM_MODEL=moonshot-v1-8k
#
#  🇨🇳 GLM (Zhipu)
#     CUSTOM_NAME=GLM
#     CUSTOM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     CUSTOM_MODEL=glm-4-flash
#
#  🌐 OpenRouter — cientos de modelos con UNA sola clave
#     CUSTOM_NAME=OpenRouter
#     CUSTOM_BASE_URL=https://openrouter.ai/api/v1
#     CUSTOM_MODEL=deepseek/deepseek-chat
#
#  ⚡ Groq — muy rápido, plan gratuito generoso
#     CUSTOM_NAME=Groq
#     CUSTOM_BASE_URL=https://api.groq.com/openai/v1
#     CUSTOM_MODEL=llama-3.3-70b-versatile
#
#  🏠 Ollama — LOCAL Y GRATIS (no necesita clave)
#     CUSTOM_NAME=Ollama
#     CUSTOM_BASE_URL=http://localhost:11434/v1
#     CUSTOM_MODEL=llama3.1
#
CUSTOM_NAME=DeepSeek
CUSTOM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=deepseek-chat

# ── Puerto del tablero (opcional, por defecto 4321) ─────────
# PORT=4321

# ══ Composio: 1000+ apps con un solo login (opcional) ══
# 1) Crea cuenta en https://app.composio.dev y copia tu API key.
# 2) Conecta tus apps (Gmail, Slack…) desde su panel.
# COMPOSIO_API_KEY=
# COMPOSIO_TOOLKITS=gmail,googlecalendar,slack
# COMPOSIO_USER_ID=default
